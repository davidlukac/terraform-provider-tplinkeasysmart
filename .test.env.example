# Copy to .test.env (gitignored) to run `make regression-live CONFIRM=1` against a real switch.
# Only switch 03 is ever a valid target; switch 01 is refused by name and by address.
TPLINK_REGRESSION_TARGET=sw03
TPLINK_REGRESSION_HOST=192.0.2.13
TPLINK_REGRESSION_USERNAME=admin
TPLINK_REGRESSION_PASSWORD=
# Ports a scenario may change: free, link-down, in no LAG.
TPLINK_REGRESSION_TEST_PORTS=2,3,4,5
# The uplink and the ports with devices: named only by guard-refusal scenarios.
TPLINK_REGRESSION_PROTECTED_PORTS=1,6,7,8
# Addresses that must never be a target, comma separated (switch 01).
TPLINK_REGRESSION_READONLY_HOSTS=192.0.2.11
# Optional: also move the switch to a spare address and back (the management-move scenario).
# The address must be free (outside the DHCP pool, nothing bound to it); it is never probed before the move.
# TPLINK_REGRESSION_ALLOW_MANAGEMENT_MOVE=1
# TPLINK_REGRESSION_MOVE_IP=192.0.2.14
# Optional: let the allow_disruptive scenario write to a port that carries a device (a brief link drop).
# TPLINK_REGRESSION_DISRUPT_DEVICE_PORT=8
